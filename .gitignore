# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which will thus
# fall under the Cargo target directory, but we include them here
# as well, as they can sometimes be produced independently.
*.pdb

# Local IDE configuration
.antigravitycli/

# Manually provisioned container rootfs (BusyBox binary, device nodes) —
# see README's "Root filesystem provisioning" section.
/rootfs/
